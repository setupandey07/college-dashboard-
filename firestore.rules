rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Authoritative check on user document in Firestore
    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserRole() == 'admin' ||
        request.auth.token.email == 'pkr02042006@gmail.com' ||
        request.auth.token.email == 'startup5077@gmail.com' ||
        request.auth.token.email == 'principal@academiccore.edu' ||
        request.auth.token.email == 'admin@academiccore.edu' ||
        request.auth.uid == 'u-admin-1'
      );
    }

    function isFacultyOrHod() {
      return isSignedIn() && (
        getUserRole() == 'faculty' ||
        getUserRole() == 'hod' ||
        isAdmin()
      );
    }

    function isLabStaff() {
      return isSignedIn() && (
        getUserRole() == 'lab_assistant' ||
        isAdmin()
      );
    }

    function getUserDeptCode() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.departmentCode != null
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.departmentCode
              : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department
          )
        : '';
    }

    // 1. System Metadata & Health Connection Check
    match /system/{docId} {
      allow read: if true; // Connection handshake check
      allow write: if isAdmin();
    }

    match /test/{docId} {
      allow read, write: if isAdmin();
    }

    // 2. Users Collection (Profile Management & Privilege Escalation Protection)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow update: if (
        isAdmin() ||
        // HOD can update members within their own department (cannot modify admin accounts or tamper with roles):
        (getUserRole() == 'hod' && existing().role != 'admin' && (
          existing().departmentCode == getUserDeptCode() || existing().department == getUserDeptCode()
        ) && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'id', 'uid'])) ||
        // Self-profile update
        (isSignedIn() && request.auth.uid == userId && 
         // Absolute protection against privilege escalation:
         !incoming().diff(existing()).affectedKeys().hasAny([
           'role', 'regId', 'email', 'status', 'id', 'uid'
         ]) &&
         // Students cannot self-alter their statutory class placement:
         (getUserRole() != 'student' || !incoming().diff(existing()).affectedKeys().hasAny([
           'department', 'departmentCode', 'section', 'semester', 'currentAcademicYear'
         ]))
        )
      );
      // Absolute Admin Protection: No user or HOD can delete an Administrator account or u-admin-1
      allow delete: if isAdmin() && userId != 'u-admin-1' && existing().role != 'admin';
    }

    // 3. Students Collection (Academic & Student Profile)
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid == studentId);
      allow update: if (
        isAdmin() ||
        isFacultyOrHod() ||
        (isSignedIn() && (request.auth.uid == studentId || existing().userId == request.auth.uid) &&
         !incoming().diff(existing()).affectedKeys().hasAny([
           'rollNumber', 'registrationNumber', 'email', 'name', 'departmentId', 
           'departmentName', 'status', 'year', 'semester', 'section', 'id', 'userId'
         ]))
      );
      allow delete: if isAdmin();
    }

    // 4. Academic Departments & Sections
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isFacultyOrHod() || isAdmin();
    }

    // 5. Course Subjects & Syllabus
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isFacultyOrHod() || isAdmin();
    }

    // 6. Attendance Sessions & Records
    match /attendanceSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isFacultyOrHod() || isAdmin();
      allow update: if isAdmin() || (
        isFacultyOrHod() && (
          (getUserRole() == 'hod' && (
            existing().departmentCode == getUserDeptCode() || 
            existing().department == getUserDeptCode()
          )) ||
          (getUserRole() == 'faculty' && existing().facultyId == request.auth.uid)
        )
      );
      allow delete: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow write: if isFacultyOrHod() || isAdmin();
    }

    match /attendanceSummaries/{summaryId} {
      allow read: if isSignedIn();
      allow write: if isFacultyOrHod() || isAdmin();
    }

    // 7. Assessments & Marks (Strictly protected from student mutation; role & department scoped)
    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (
        isFacultyOrHod() && (
          (getUserRole() == 'hod' && (
            incoming().departmentCode == getUserDeptCode() || 
            incoming().department == getUserDeptCode() ||
            existing().departmentCode == getUserDeptCode()
          )) ||
          (getUserRole() == 'faculty' && (
            incoming().facultyId == request.auth.uid ||
            existing().facultyId == request.auth.uid ||
            incoming().departmentCode == getUserDeptCode() ||
            incoming().department == getUserDeptCode()
          ))
        )
      );
    }

    match /marks/{markId} {
      allow read: if isSignedIn();
      allow write: if isFacultyOrHod() || isAdmin();
    }

    match /studentMarks/{studentMarkId} {
      allow read: if isSignedIn();
      allow write: if isFacultyOrHod() || isAdmin();
    }

    // 8. Queries & Grievances (Strict Student A <-> Faculty B Isolation)
    match /queries/{queryId} {
      function isQueryOwnerOrRecipient() {
        return isAdmin() ||
          // User is creator / sender (Student A)
          resource.data.createdByUserId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid ||
          resource.data.studentId == request.auth.uid ||
          (resource.data.senderEmail != null && resource.data.senderEmail == request.auth.token.email) ||
          // User is direct assigned recipient (Faculty B)
          resource.data.recipientUserId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid ||
          // User is HOD of the targeted department (Administrative oversight within department)
          (getUserRole() == 'hod' && (
            resource.data.recipientUserId == request.auth.uid ||
            resource.data.recipientId == request.auth.uid ||
            (resource.data.recipientDepartment != null && resource.data.recipientDepartment == getUserDeptCode()) ||
            (resource.data.departmentId != null && resource.data.departmentId == getUserDeptCode()) ||
            (resource.data.department != null && resource.data.department == getUserDeptCode())
          )) ||
          // User is Lab Assistant targeted directly
          (getUserRole() == 'lab_assistant' && (
            resource.data.recipientUserId == request.auth.uid ||
            resource.data.recipientId == request.auth.uid
          ));
      }

      // Single document get: strictly protected against accessing by ID or changing URL
      allow get: if isSignedIn() && isQueryOwnerOrRecipient();

      // List queries: allowed for admin or if user is owner/recipient
      allow list: if isSignedIn() && isQueryOwnerOrRecipient();

      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        isAdmin() ||
        isQueryOwnerOrRecipient()
      );

      allow delete: if isAdmin() || (isSignedIn() && (
        resource.data.createdByUserId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      ));

      match /responses/{responseId} {
        allow get, list: if isSignedIn() && (
          isAdmin() ||
          get(/databases/$(database)/documents/queries/$(queryId)).data.createdByUserId == request.auth.uid ||
          get(/databases/$(database)/documents/queries/$(queryId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/queries/$(queryId)).data.recipientUserId == request.auth.uid ||
          get(/databases/$(database)/documents/queries/$(queryId)).data.recipientId == request.auth.uid ||
          (getUserRole() == 'hod' && (
            get(/databases/$(database)/documents/queries/$(queryId)).data.recipientDepartment == getUserDeptCode() ||
            get(/databases/$(database)/documents/queries/$(queryId)).data.departmentId == getUserDeptCode() ||
            get(/databases/$(database)/documents/queries/$(queryId)).data.department == getUserDeptCode()
          ))
        );
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // 9. Innovation Projects & Comments
    match /problems/{problemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // 10. Announcements & Circulars
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isFacultyOrHod() || isAdmin();
    }

    // 11. Laboratory Equipment
    match /labEquipment/{equipmentId} {
      allow read: if isSignedIn();
      allow write: if isLabStaff() || isAdmin();
    }

    // 12. Faculty Workloads
    match /workloads/{facultyId} {
      allow read: if isSignedIn();
      allow write: if isFacultyOrHod() || isAdmin();
    }

    // 13. Private Notifications (Strict Recipient Isolation)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.recipientUserId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.recipientUserId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // 14. Audit Logs (Append-only; never editable or deletable)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 15. Timetables Collection (Class / Section weekly schedule)
    match /timetables/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isFacultyOrHod() || isAdmin();
    }

    // 16. Academic Batches Collection
    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (
        getUserRole() == 'hod' && (
          incoming().departmentCode == null ||
          incoming().departmentCode == 'all' ||
          incoming().departmentCode == getUserDeptCode()
        )
      );
      allow delete: if isAdmin();
    }

    // 17. Master Notes & Learning Materials Repository (College-wide Access)
    match /notes/{noteId} {
      // Students and all institutional members can read permitted repository notes
      allow read: if isSignedIn();

      // Faculty, HOD, and Admin can upload notes with verified author identification
      allow create: if (isFacultyOrHod() || isAdmin()) && (
        incoming().uploadedBy == request.auth.uid || isAdmin()
      );

      // Updates: Admin can update any; HOD can update their department's notes; Faculty only their own notes
      allow update: if isAdmin() || (
        (getUserRole() == 'hod' && (
          existing().departmentCode == getUserDeptCode() ||
          existing().department == getUserDeptCode()
        )) ||
        (getUserRole() == 'faculty' && existing().uploadedBy == request.auth.uid)
      );

      // Deletes: Admin can delete any; HOD can delete in their department; Faculty only their own notes
      allow delete: if isAdmin() || (
        (getUserRole() == 'hod' && (
          existing().departmentCode == getUserDeptCode() ||
          existing().department == getUserDeptCode()
        )) ||
        (getUserRole() == 'faculty' && existing().uploadedBy == request.auth.uid)
      );
    }
  }
}
